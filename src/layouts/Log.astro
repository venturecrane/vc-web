---
import Base from './Base.astro'
import TagList from '../components/TagList.astro'
import Subscribe from '../components/Subscribe.astro'
import RelatedContent from '../components/RelatedContent.astro'

interface Props {
  id: string
  title: string
  date: Date
  tags?: string[]
  shipped?: string
  impact?: string
  surprise?: string
  nextConstraint?: string
}

const { id, title, date, tags = [], shipped, impact, surprise, nextConstraint } = Astro.props
const canonicalURL = new URL(Astro.url.pathname, Astro.site)

const formatDate = (d: Date) =>
  d.toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' })

const blogPostingSchema = {
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  headline: title,
  datePublished: date.toISOString(),
  author: { '@type': 'Organization', name: 'Venture Crane' },
  publisher: {
    '@type': 'Organization',
    name: 'Venture Crane',
    logo: { '@type': 'ImageObject', url: 'https://venturecrane.com/favicon.svg' },
  },
  keywords: tags.join(', '),
  url: canonicalURL.href,
  mainEntityOfPage: { '@type': 'WebPage', '@id': canonicalURL.href },
}
---

<Base title={title} jsonLd={blogPostingSchema}>
  <div
    class="rounded-lg bg-surface p-6 sm:p-8"
    data-pagefind-body
    data-pagefind-meta={`type:log, date:${date.toISOString().split('T')[0]}`}
  >
    <header class="mb-8">
      <h1 class="mb-3">{title}</h1>
      <div class="text-sm text-vc-text-muted">
        {formatDate(date)}
      </div>
      {
        tags.length > 0 && (
          <div class="mt-2">
            <TagList tags={tags} />
          </div>
        )
      }
    </header>

    {
      (shipped || impact || surprise || nextConstraint) && (
        <div class="mb-8 rounded border border-border bg-surface-raised p-4 text-sm">
          {shipped && (
            <div class="mb-2">
              <strong>Shipped:</strong> {shipped}
            </div>
          )}
          {impact && (
            <div class="mb-2">
              <strong>Impact:</strong> {impact}
            </div>
          )}
          {surprise && (
            <div class="mb-2">
              <strong>Surprise:</strong> {surprise}
            </div>
          )}
          {nextConstraint && (
            <div>
              <strong>Next constraint:</strong> {nextConstraint}
            </div>
          )}
        </div>
      )
    }

    <div class="vc-prose">
      <slot />
    </div>

    <aside class="mt-12 border-t border-border pt-6 text-sm text-vc-text-muted">
      <p>
        Thoughts?{' '}
        <a href="/contact/" class="text-accent hover:text-accent-hover"> Get in touch </a>
      </p>
    </aside>

    <Subscribe variant="inline" />

    <RelatedContent currentId={id} currentTags={tags} />
  </div>

  <script is:inline src="/js/subscribe.js"></script>
</Base>
