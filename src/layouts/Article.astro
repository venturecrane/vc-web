---
import Base from './Base.astro'
import ArticleMeta from '../components/ArticleMeta.astro'
import AIDisclosure from '../components/AIDisclosure.astro'
import TagList from '../components/TagList.astro'

interface Heading {
  depth: number
  slug: string
  text: string
}

interface Props {
  title: string
  description: string
  date: Date
  readingTime: number
  author: string
  updatedDate?: Date
  tags?: string[]
  prevArticle?: { slug: string; title: string }
  nextArticle?: { slug: string; title: string }
  headings?: Heading[]
}

const {
  title,
  description,
  date,
  readingTime,
  author,
  updatedDate,
  tags = [],
  prevArticle,
  nextArticle,
  headings = [],
} = Astro.props
const showToc = headings.length > 0
---

<Base title={`${title} | Venture Crane`} description={description}>
  <div class="rounded-lg bg-surface p-4 sm:p-6 lg:p-8">
    <header class="mb-8">
      <h1 class="mb-3">{title}</h1>
      <ArticleMeta
        date={date}
        readingTime={readingTime}
        author={author}
        updatedDate={updatedDate}
      />
      {
        tags.length > 0 && (
          <div class="mt-3">
            <TagList tags={tags} />
          </div>
        )
      }
    </header>

    {
      showToc && (
        <nav class="article-toc mb-8 border-b border-border pb-6" aria-label="Table of contents">
          <details class="sm:open">
            <summary class="cursor-pointer text-sm font-semibold text-vc-text-muted uppercase tracking-wide">
              In this article
            </summary>
            <ol class="mt-3 list-none space-y-1.5 pl-0 text-sm">
              {headings.map((h) => (
                <li>
                  <a href={`#${h.slug}`} class="text-vc-text-muted no-underline hover:text-accent">
                    {h.text}
                  </a>
                </li>
              ))}
            </ol>
          </details>
        </nav>
      )
    }

    <div class="vc-prose">
      <slot />
    </div>

    <AIDisclosure author={author} />

    {
      (prevArticle || nextArticle) && (
        <nav
          class="mt-12 flex justify-between border-t border-border pt-6 text-sm"
          aria-label="Article navigation"
        >
          {prevArticle ? (
            <a href={`/articles/${prevArticle.slug}/`} class="text-accent hover:text-accent-hover">
              &larr; {prevArticle.title}
            </a>
          ) : (
            <span />
          )}
          {nextArticle ? (
            <a href={`/articles/${nextArticle.slug}/`} class="text-accent hover:text-accent-hover">
              {nextArticle.title} &rarr;
            </a>
          ) : (
            <span />
          )}
        </nav>
      )
    }
  </div>
</Base>
