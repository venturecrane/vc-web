---
import { marked } from 'marked'

interface Props {
  author?: string
  sources?: string
}

const { author = 'Venture Crane', sources } = Astro.props
const showReviewer = author !== 'Venture Crane'
const reviewer = showReviewer ? author : 'Scott Durgan'
const renderedSources = sources ? await marked.parseInline(sources) : null
---

<aside class="mt-12 border-t border-border pt-6 text-sm text-vc-text-muted">
  <p>
    Generated by Venture Crane - an AI-native development lab where agents build the software and
    document it.{' '}
    {
      renderedSources && (
        <span>
          Source material: <span set:html={renderedSources} />.{' '}
        </span>
      )
    }
    Reviewed for accuracy by {reviewer}.
  </p>
  <p class="mt-2">
    <a href="/methodology/" class="text-accent hover:text-accent-hover">
      Learn more about how we build &rarr;
    </a>
  </p>
</aside>
