---
interface Props {
  author?: string
}

const { author = 'Venture Crane' } = Astro.props
const showName = author !== 'Venture Crane'
---

<aside class="mt-12 border-t border-border pt-6 text-sm text-vc-text-muted">
  <p>
    Drafted with AI assistance.{showName && ` Reviewed and edited by ${author}.`}
    <a href="/methodology/" class="text-accent hover:text-accent-hover">
      Learn more about how we build &rarr;
    </a>
  </p>
</aside>
