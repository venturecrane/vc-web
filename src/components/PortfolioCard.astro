---
import type { Venture } from '../data/ventures'

interface Props {
  venture: Venture
}

const { venture } = Astro.props

const statusColors: Record<Venture['status'], string> = {
  building: 'bg-gray-700/40 text-gray-300 border-gray-600/50',
  beta: 'bg-yellow-900/40 text-yellow-300 border-yellow-700/50',
  live: 'bg-green-900/40 text-green-300 border-green-700/50',
  paused: 'bg-orange-900/40 text-orange-300 border-orange-700/50',
  sunset: 'bg-gray-800/40 text-gray-400 border-gray-700/50',
  internal: 'bg-blue-900/40 text-blue-300 border-blue-700/50',
}

const statusLabels: Record<Venture['status'], string> = {
  building: 'Building',
  beta: 'Beta',
  live: 'Live',
  paused: 'Paused',
  sunset: 'Sunset',
  internal: 'Internal',
}

const isClickable = (venture.status === 'live' || venture.status === 'beta') && venture.url
---

{
  isClickable ? (
    <article class="group relative rounded-lg border border-border bg-surface p-6 transition-colors hover:border-accent hover:bg-surface-raised">
      <a
        href={venture.url}
        target="_blank"
        rel="noopener noreferrer"
        class="absolute inset-0 z-10 rounded-lg"
        aria-label={`Visit ${venture.name}`}
      />
      <div class="mb-3 flex items-start justify-between gap-3">
        <div class="flex items-center gap-2">
          <h3 class="text-lg font-semibold text-vc-text">{venture.name}</h3>
          <svg
            xmlns="http://www.w3.org/2000/svg"
            width="14"
            height="14"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
            class="text-vc-text-muted transition-colors group-hover:text-accent"
            aria-hidden="true"
          >
            <path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6" />
            <polyline points="15 3 21 3 21 9" />
            <line x1="10" y1="14" x2="21" y2="3" />
          </svg>
        </div>
        <span
          class:list={[
            'inline-flex shrink-0 items-center rounded-full border px-2.5 py-0.5 text-xs font-medium',
            statusColors[venture.status],
          ]}
        >
          {statusLabels[venture.status]}
        </span>
      </div>

      <p class="mb-4 text-sm text-vc-text-muted">{venture.description}</p>

      <div class="flex flex-wrap gap-1.5">
        {venture.techStack.map((tech) => (
          <span class="rounded bg-surface-raised px-2 py-0.5 text-xs text-vc-text-muted">
            {tech}
          </span>
        ))}
      </div>
    </article>
  ) : (
    <article class="rounded-lg border border-border bg-surface p-6">
      <div class="mb-3 flex items-start justify-between gap-3">
        <h3 class="text-lg font-semibold text-vc-text">{venture.name}</h3>
        <span
          class:list={[
            'inline-flex shrink-0 items-center rounded-full border px-2.5 py-0.5 text-xs font-medium',
            statusColors[venture.status],
          ]}
        >
          {statusLabels[venture.status]}
        </span>
      </div>

      <p class="mb-4 text-sm text-vc-text-muted">{venture.description}</p>

      <div class="flex flex-wrap gap-1.5">
        {venture.techStack.map((tech) => (
          <span class="rounded bg-surface-raised px-2 py-0.5 text-xs text-vc-text-muted">
            {tech}
          </span>
        ))}
      </div>
    </article>
  )
}
