---
const pathname = Astro.url.pathname

const navLinks = [
  { href: '/', label: 'Home' },
  { href: '/articles/', label: 'Articles' },
  { href: '/portfolio/', label: 'Portfolio' },
  { href: '/methodology/', label: 'Methodology' },
]
---

<details class="mobile-nav sm:hidden">
  <summary class="flex h-11 w-11 cursor-pointer items-center justify-center" aria-label="Menu">
    <div class="hamburger" aria-hidden="true">
      <span></span>
      <span></span>
      <span></span>
    </div>
  </summary>
  <nav
    class="absolute left-0 right-0 border-b border-border bg-chrome px-4 py-4"
    aria-label="Mobile"
  >
    {
      navLinks.map(({ href, label }) => (
        <a
          href={href}
          aria-current={pathname === href ? 'page' : undefined}
          class:list={[
            'block py-3 text-sm no-underline',
            pathname === href
              ? 'text-accent font-semibold'
              : 'text-vc-text-muted hover:text-vc-text',
          ]}
        >
          {label}
        </a>
      ))
    }
  </nav>
</details>

<style>
  .mobile-nav {
    position: relative;
  }

  .mobile-nav summary {
    list-style: none;
  }

  .mobile-nav summary::-webkit-details-marker {
    display: none;
  }

  .mobile-nav summary::marker {
    display: none;
  }

  .hamburger {
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: 5px;
    width: 20px;
    height: 20px;
  }

  .hamburger span {
    display: block;
    height: 2px;
    width: 100%;
    background: var(--vc-text);
    border-radius: 1px;
    transition:
      transform 0.2s ease,
      opacity 0.2s ease;
    transform-origin: center;
  }

  details[open] .hamburger span:nth-child(1) {
    transform: translateY(7px) rotate(45deg);
  }

  details[open] .hamburger span:nth-child(2) {
    opacity: 0;
  }

  details[open] .hamburger span:nth-child(3) {
    transform: translateY(-7px) rotate(-45deg);
  }
</style>
