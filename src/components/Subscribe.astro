---
interface Props {
  variant?: 'inline' | 'card'
}

const { variant = 'inline' } = Astro.props
---

{
  variant === 'card' ? (
    <aside class="mt-12 rounded-lg border border-border bg-surface-raised p-6">
      <p class="mb-1 font-semibold text-vc-text">Subscribe to the build log</p>
      <p class="mb-4 text-sm text-vc-text-muted">
        Short emails when we ship something new. No spam, unsubscribe anytime.
      </p>
      <form
        class="subscribe-form flex flex-col gap-3 sm:flex-row sm:items-center sm:gap-2"
        action="/api/subscribe"
        method="POST"
      >
        <input
          type="email"
          name="email"
          required
          maxlength="254"
          autocomplete="email"
          placeholder="you@example.com"
          class="w-full rounded border border-border bg-chrome px-3 py-2 text-sm text-vc-text placeholder:text-vc-text-muted/50 focus:border-accent focus:outline-none focus:ring-1 focus:ring-accent sm:max-w-[16rem]"
        />
        <div class="absolute -left-[9999px]" aria-hidden="true">
          <label for="subscribe-website">Website</label>
          <input
            type="text"
            id="subscribe-website"
            name="website"
            tabindex="-1"
            autocomplete="off"
          />
        </div>
        <button
          type="submit"
          class="rounded border border-accent bg-accent/10 px-4 py-2 text-sm font-medium text-accent hover:bg-accent/20"
        >
          Subscribe
        </button>
      </form>
      <div class="subscribe-status mt-3" aria-live="polite" />
    </aside>
  ) : (
    <aside class="mt-8 border-t border-border pt-6">
      <form
        class="subscribe-form flex flex-col gap-3 sm:flex-row sm:items-center sm:gap-2"
        action="/api/subscribe"
        method="POST"
      >
        <span class="text-sm text-vc-text-muted">Get notified when we publish</span>
        <input
          type="email"
          name="email"
          required
          maxlength="254"
          autocomplete="email"
          placeholder="you@example.com"
          class="w-full rounded border border-border bg-chrome px-3 py-2 text-sm text-vc-text placeholder:text-vc-text-muted/50 focus:border-accent focus:outline-none focus:ring-1 focus:ring-accent sm:max-w-[14rem]"
        />
        <div class="absolute -left-[9999px]" aria-hidden="true">
          <label for="subscribe-website-inline">Website</label>
          <input
            type="text"
            id="subscribe-website-inline"
            name="website"
            tabindex="-1"
            autocomplete="off"
          />
        </div>
        <button
          type="submit"
          class="rounded border border-accent bg-accent/10 px-4 py-2 text-sm font-medium text-accent hover:bg-accent/20"
        >
          Subscribe
        </button>
      </form>
      <div class="subscribe-status mt-2" aria-live="polite" />
    </aside>
  )
}
