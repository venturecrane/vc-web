---
import MobileNav from './MobileNav.astro'

const pathname = Astro.url.pathname

const navLinks = [
  { href: '/start-here/', label: 'Start Here' },
  { href: '/articles/', label: 'Articles' },
  { href: '/log/', label: 'Ship Log' },
  { href: '/the-system/', label: 'The System' },
  { href: '/open-problems/', label: 'Open Problems' },
  { href: '/contact/', label: 'Contact' },
]
---

<header class="relative border-b border-border bg-chrome">
  <div
    class="mx-auto flex max-w-[var(--vc-content-width)] items-center justify-between px-4 py-4 sm:px-6"
  >
    <a
      href="/"
      class="font-mono text-lg font-bold uppercase tracking-[0.05em] no-underline"
      style="word-spacing: -0.15em;"
    >
      <span class="text-vc-text hover:text-gold-hover">Venture</span>{' '}
      <span class="text-gold hover:text-gold-hover">Crane</span>
    </a>

    <nav class="hidden sm:flex sm:items-center sm:gap-4" aria-label="Main">
      {
        navLinks.map(({ href, label }) => (
          <a
            href={href}
            aria-current={pathname === href ? 'page' : undefined}
            class:list={[
              'text-sm no-underline transition-colors',
              pathname === href
                ? 'text-accent font-semibold'
                : 'text-vc-text-muted hover:text-vc-text',
            ]}
          >
            {label}
          </a>
        ))
      }
      <a
        href="/search/"
        aria-label="Search"
        class:list={[
          'text-sm no-underline transition-colors',
          pathname === '/search/' ? 'text-accent' : 'text-vc-text-muted hover:text-vc-text',
        ]}
      >
        <svg
          xmlns="http://www.w3.org/2000/svg"
          width="16"
          height="16"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
        >
          <circle cx="11" cy="11" r="8"></circle>
          <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
        </svg>
      </a>
    </nav>

    <MobileNav />
  </div>
</header>
