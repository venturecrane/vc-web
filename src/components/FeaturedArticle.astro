---
interface Props {
  title: string
  date: Date
  description: string
  readingTime: number
  slug: string
}

const { title, date, description, readingTime, slug } = Astro.props

const formatDate = (d: Date) =>
  d.toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' })
---

<a
  href={`/articles/${slug}/`}
  class="group block rounded-lg bg-surface p-6 no-underline transition-colors hover:bg-surface-raised sm:p-8"
>
  <h2 class="text-2xl font-semibold text-vc-text group-hover:text-accent sm:text-3xl">{title}</h2>
  <div class="mt-2 text-sm text-vc-text-muted">
    {formatDate(date)} &middot; {readingTime} min read
  </div>
  <p class="mt-3 text-vc-text-muted">{description}</p>
  <span class="mt-4 inline-block text-sm font-medium text-accent group-hover:text-accent-hover">
    Read article &rarr;
  </span>
</a>
