---
interface Props {
  prevUrl: string | undefined
  nextUrl: string | undefined
  currentPage: number
  lastPage: number
}

const { prevUrl, nextUrl, currentPage, lastPage } = Astro.props
---

{
  lastPage > 1 && (
    <nav aria-label="Pagination" class="mt-12 flex items-center justify-between">
      <div>
        {prevUrl ? (
          <a
            href={prevUrl}
            class="text-sm font-medium text-vc-text-muted no-underline transition-colors hover:text-accent"
          >
            &larr; Previous
          </a>
        ) : (
          <span />
        )}
      </div>
      <div class="text-sm text-vc-text-muted">
        Page {currentPage} of {lastPage}
      </div>
      <div>
        {nextUrl ? (
          <a
            href={nextUrl}
            class="text-sm font-medium text-vc-text-muted no-underline transition-colors hover:text-accent"
          >
            Next &rarr;
          </a>
        ) : (
          <span />
        )}
      </div>
    </nav>
  )
}
