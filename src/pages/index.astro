---
import Base from '../layouts/Base.astro'
import FeaturedArticle from '../components/FeaturedArticle.astro'
import ArticleCard from '../components/ArticleCard.astro'
import LogEntry from '../components/LogEntry.astro'
import { getCollection } from 'astro:content'

const articles = (await getCollection('articles'))
  .filter((a) => !a.data.draft)
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime())

const logs = (await getCollection('logs'))
  .filter((l) => !l.data.draft)
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime())
  .slice(0, 5)

const leadArticle = articles[0]
const remainingArticles = articles.slice(1, 5)
---

<Base title="Venture Crane">
  <section class="pb-8 pt-6 sm:pb-12 sm:pt-8">
    <h1 class="text-2xl font-bold sm:text-3xl">Field Notes: Building with AI Agent Teams</h1>
    <p class="mt-2 text-vc-text-muted">
      Venture Crane is a solo-founder studio that builds products with multi-agent development teams
      and publishes what we learn.
    </p>
  </section>

  {
    articles.length > 0 && (
      <section class="mb-16">
        <div class="mb-6 flex items-baseline justify-between">
          <h2 class="text-xl font-semibold">Articles</h2>
          {articles.length > 1 && (
            <a href="/articles/" class="text-sm text-vc-text-muted no-underline hover:text-accent">
              View all
            </a>
          )}
        </div>
        <FeaturedArticle
          title={leadArticle.data.title}
          date={leadArticle.data.date}
          description={leadArticle.data.description}
          readingTime={Math.ceil(leadArticle.body!.split(/\s+/).length / 225)}
          slug={leadArticle.id}
        />
        {remainingArticles.length > 0 && (
          <div class="mt-4 flex flex-col gap-4">
            {remainingArticles.map((article) => (
              <ArticleCard
                title={article.data.title}
                date={article.data.date}
                description={article.data.description}
                readingTime={Math.ceil(article.body!.split(/\s+/).length / 225)}
                slug={article.id}
                tags={article.data.tags}
              />
            ))}
          </div>
        )}
      </section>
    )
  }

  <section class="mb-16">
    <div class="mb-6 flex items-baseline justify-between">
      <h2 class="text-xl font-semibold">Build Log</h2>
      <a href="/log/" class="text-sm text-vc-text-muted no-underline hover:text-accent">
        View all
      </a>
    </div>
    {
      logs.length > 0 ? (
        <div class="flex flex-col gap-4">
          {logs.map((log) => (
            <LogEntry
              title={log.data.title}
              date={log.data.date}
              slug={log.id}
              tags={log.data.tags}
            />
          ))}
        </div>
      ) : (
        <p class="text-vc-text-muted">Build log entries coming soon.</p>
      )
    }
  </section>

  <section class="mb-16 border-t border-border pt-8">
    <h2 class="mb-4 text-sm font-semibold uppercase tracking-wider text-vc-text-muted">
      Why We Publish
    </h2>
    <p class="text-vc-text-muted">
      The discipline of AI-native development operations is forming right now. The vocabulary is
      new, the patterns are unstable, and most of what gets published is either vendor marketing or
      surface-level tutorials. This site publishes field notes from a working operation -
      methodology, real costs, honest failures. Not a tutorial. Not a pitch. Processed
      retrospectives from practice, contributed to a discipline that could use more of them.
    </p>
    <a href="/methodology/" class="mt-3 inline-block text-sm text-accent hover:text-accent-hover">
      How we work &rarr;
    </a>
  </section>
</Base>
