---
import Base from '../layouts/Base.astro'
import ArticleCard from '../components/ArticleCard.astro'
import LogEntry from '../components/LogEntry.astro'
import { getCollection } from 'astro:content'

const thesisSlugs = [
  'why-development-lab',
  'what-ai-agents-actually-cost',
  'kill-discipline-ai-agents',
]
const operationsSlugs = [
  'multi-agent-team-protocols',
  'sessions-heartbeats-handoffs',
  'agent-context-management-system',
]
const curatedSlugs = new Set([...thesisSlugs, ...operationsSlugs])

const allArticles = (await getCollection('articles')).filter((a) => !a.data.draft)

// Build-time assertions: fail loudly if curated articles are missing
const missingThesis = thesisSlugs.filter((s) => !allArticles.find((a) => a.id === s))
if (missingThesis.length) {
  throw new Error(`Homepage: missing thesis articles: ${missingThesis.join(', ')}`)
}
const missingOps = operationsSlugs.filter((s) => !allArticles.find((a) => a.id === s))
if (missingOps.length) {
  throw new Error(`Homepage: missing operations articles: ${missingOps.join(', ')}`)
}

const thesisArticles = thesisSlugs.map((slug) => allArticles.find((a) => a.id === slug)!)

const operationsArticles = operationsSlugs.map((slug) => allArticles.find((a) => a.id === slug)!)

const latestArticle = allArticles
  .filter((a) => !curatedSlugs.has(a.id))
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime())[0]

const logs = (await getCollection('logs'))
  .filter((l) => !l.data.draft)
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime())
  .slice(0, 3)
---

<Base title="Venture Crane">
  <section class="pb-8 pt-6 sm:pb-12 sm:pt-8">
    <h1 class="text-2xl font-bold sm:text-3xl">
      Field Notes from Running AI Agent Teams in Production
    </h1>
    <p class="mt-2 text-vc-text-muted">
      Venture Crane is a development lab that ships products with AI agent teams across multiple
      ventures simultaneously. These are the systems, costs, and failures from that operation.
    </p>
    <p class="mt-3 text-sm text-vc-text-muted">
      New here?
      <a href="/start-here/" class="text-accent hover:text-accent-hover">Start Here</a> for curated reading
      paths, or read
      <a href="/the-system/" class="text-accent hover:text-accent-hover">The System</a> for the operating
      model behind it.
    </p>
  </section>

  <section class="mb-16">
    <h2 class="mb-6 text-xl font-semibold">The Thesis</h2>
    <div class="flex flex-col gap-4">
      {
        thesisArticles.map((article) => (
          <ArticleCard
            title={article.data.title}
            date={article.data.date}
            description={article.data.description}
            readingTime={Math.ceil(article.body!.split(/\s+/).length / 225)}
            slug={article.id}
            tags={article.data.tags}
          />
        ))
      }
    </div>
  </section>

  <section class="mb-16">
    <h2 class="mb-6 text-xl font-semibold">How It Works</h2>
    <div class="flex flex-col gap-4">
      {
        operationsArticles.map((article) => (
          <ArticleCard
            title={article.data.title}
            date={article.data.date}
            description={article.data.description}
            readingTime={Math.ceil(article.body!.split(/\s+/).length / 225)}
            slug={article.id}
            tags={article.data.tags}
          />
        ))
      }
    </div>
  </section>

  <section class="mb-16">
    <div class="mb-6 flex items-baseline justify-between">
      <h2 class="text-xl font-semibold">Latest</h2>
    </div>
    {
      latestArticle && (
        <ArticleCard
          title={latestArticle.data.title}
          date={latestArticle.data.date}
          description={latestArticle.data.description}
          readingTime={Math.ceil(latestArticle.body!.split(/\s+/).length / 225)}
          slug={latestArticle.id}
          tags={latestArticle.data.tags}
        />
      )
    }
    {
      logs.length > 0 && (
        <div class="mt-4 flex flex-col gap-4">
          {logs.map((log) => (
            <LogEntry
              title={log.data.title}
              date={log.data.date}
              slug={log.id}
              tags={log.data.tags}
            />
          ))}
        </div>
      )
    }
    <div class="mt-4 flex gap-6 text-sm">
      <a href="/articles/" class="text-vc-text-muted no-underline hover:text-accent">
        All articles &rarr;
      </a>
      <a href="/log/" class="text-vc-text-muted no-underline hover:text-accent">
        All log entries &rarr;
      </a>
    </div>
  </section>

  <section class="mb-16 border-t border-border pt-8">
    <h2 class="mb-4 text-sm font-semibold uppercase tracking-wider text-vc-text-muted">
      Go Deeper
    </h2>
    <div class="flex flex-col gap-3 text-sm sm:flex-row sm:gap-6">
      <a href="/the-system/" class="text-accent hover:text-accent-hover">
        The System &rarr;
        <span class="block text-vc-text-muted">Beliefs, primitives, session lifecycle</span>
      </a>
      <a href="/start-here/" class="text-accent hover:text-accent-hover">
        Start Here &rarr;
        <span class="block text-vc-text-muted">Curated paths by audience</span>
      </a>
      <a href="/open-problems/" class="text-accent hover:text-accent-hover">
        Open Problems &rarr;
        <span class="block text-vc-text-muted"
          >What we haven't solved yet - and how to work on them with us</span
        >
      </a>
    </div>
  </section>
</Base>
