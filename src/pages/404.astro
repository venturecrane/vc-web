---
import Base from '../layouts/Base.astro'
---

<Base title="Page Not Found">
  <div class="py-16 text-center sm:py-24">
    <h1 class="mb-4">Page not found</h1>
    <p class="mx-auto mb-8 max-w-lg text-lg text-vc-text-muted">
      The page you're looking for doesn't exist or has been moved.
    </p>
    <div class="flex justify-center gap-4">
      <a
        href="/"
        class="rounded border border-accent bg-accent/10 px-4 py-2 text-sm font-medium text-accent no-underline hover:bg-accent/20"
      >
        Go home
      </a>
      <a
        href="/articles/"
        class="rounded border border-border px-4 py-2 text-sm font-medium text-vc-text-muted no-underline hover:border-accent hover:text-vc-text"
      >
        Browse articles
      </a>
    </div>
  </div>
</Base>
