---
import Log from '../../layouts/Log.astro'
import { getCollection, render } from 'astro:content'

export async function getStaticPaths() {
  const allLogs = (await getCollection('logs')).filter((l) => !l.data.draft)

  return allLogs.map((log) => ({
    params: { slug: log.id },
    props: { log },
  }))
}

const { log } = Astro.props
const { Content } = await render(log)
---

<Log
  id={log.id}
  title={log.data.title}
  date={log.data.date}
  tags={log.data.tags}
  shipped={log.data.shipped}
  impact={log.data.impact}
  surprise={log.data.surprise}
  nextConstraint={log.data.nextConstraint}
>
  <Content />
</Log>
