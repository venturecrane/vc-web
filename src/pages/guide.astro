---
import Base from '../layouts/Base.astro'
import Subscribe from '../components/Subscribe.astro'
import { getEntry, render } from 'astro:content'

const page = await getEntry('pages', 'guide')
if (!page) throw new Error('Missing guide.md in pages collection')
const { Content } = await render(page)

const formatDate = (d: Date) =>
  d.toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' })
---

<Base
  title="AI Agent Operations Guide | Venture Crane"
  description="A curated reading path through field notes on running multi-agent AI development teams in production. Costs, reliability, context management, infrastructure."
>
  <div class="rounded-lg bg-surface p-6 sm:p-8">
    <h1 class="mb-8 text-3xl font-bold">{page.data.title}</h1>

    <div class="vc-prose">
      <Content />
    </div>

    <Subscribe variant="inline" />

    {
      page.data.updatedDate && (
        <div class="mt-8 text-sm text-vc-text-muted">
          Last updated: {formatDate(page.data.updatedDate)}
        </div>
      )
    }
  </div>
  <script is:inline src="/js/subscribe.js"></script>
</Base>
